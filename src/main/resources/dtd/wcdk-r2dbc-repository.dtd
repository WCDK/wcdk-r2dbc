<?xml version="1.0" encoding="UTF-8"?>

<!ELEMENT repository (select|insert|update|delete)*>
<!ATTLIST repository
        namespace CDATA #REQUIRED>

<!ELEMENT select (#PCDATA)>
<!ATTLIST select
        id CDATA #REQUIRED
        resultType CDATA #IMPLIED>

<!ELEMENT insert (#PCDATA)>
<!ATTLIST insert
        id CDATA #REQUIRED>

<!ELEMENT update (#PCDATA)>
<!ATTLIST update
        id CDATA #REQUIRED>

<!ELEMENT delete (#PCDATA)>
<!ATTLIST delete
        id CDATA #REQUIRED>
